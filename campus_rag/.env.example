# campus_rag LLM/Embedding 配置（可选覆盖）
# 默认从 ../settings.json 读取 API key 和 base_url，以下环境变量可覆盖默认值。

# LLM 生成回答用（默认 provider: openai，使用 settings.json 的 api_key/base_url）
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxx        # 覆盖 settings.json 中的 api_key
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat

# 若要使用本地 Ollama 生成回答：
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1:8b

# Embedding 配置（默认 provider: ollama）
# EMBED_PROVIDER=ollama
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_HOST=http://127.0.0.1:11434

# 若使用 openai 兼容的 embedding：
# EMBED_PROVIDER=openai
# OPENAI_EMBED_MODEL=text-embedding-3-small
