# campus_rag LLM/Embedding/Reranker 配置
# LLM 默认从 ../settings.json 读取 API key 和 base_url，以下环境变量可覆盖默认值。

# LLM 生成回答用（默认 provider: openai，使用 settings.json 的 api_key/base_url）
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxx        # 覆盖 settings.json 中的 api_key
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat

# 若要使用本地 Ollama 生成回答：
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1:8b

# ── Embedding：API 调用 qwen3-embedding（OpenAI 兼容端点）──
# 注意使用独立的 EMBED_* 变量，不要复用 OPENAI_*（会被 LLM 分支优先读取导致互相污染）
EMBED_PROVIDER=openai
EMBED_API_KEY=sk-xxx
EMBED_BASE_URL=https://api.llm.ustc.edu.cn/v1
EMBED_MODEL=qwen3-embedding

# 旧的本地 Ollama embedding（已停用，保留作回退方案）：
# EMBED_PROVIDER=ollama
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_HOST=http://127.0.0.1:11434

# ── Reranker：API 调用 qwen3-reranker（Cohere/Jina 风格 /rerank 端点）──
# 未配置 RERANK_PROVIDER=api 时自动降级为按原始向量分数排序
RERANK_PROVIDER=api
RERANK_API_KEY=sk-xxx
RERANK_BASE_URL=https://api.llm.ustc.edu.cn/v1
RERANK_MODEL=qwen3-reranker

# ── 联网搜索（Agent 工具 web_search）──
# WEBSEARCH_PROVIDER: tavily（需 Key，免费版 1000 次/月，效果好）或 ddg（DuckDuckGo，免 Key 兜底）
# WEBSEARCH_PROVIDER=tavily
# TAVILY_API_KEY=tvly-xxx
